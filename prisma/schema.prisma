// Prisma schema for the agency website.
// Connection URL lives in prisma.config.ts (Prisma 7).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────
// Admin
// ─────────────────────────────────────────────────────────────

model AdminUser {
  id           String    @id @default(cuid())
  email        String    @unique @db.VarChar(254)
  name         String    @db.VarChar(120)
  passwordHash String
  /// Incremented to invalidate all existing sessions for this user.
  tokenVersion Int       @default(0)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

// ─────────────────────────────────────────────────────────────
// Content
// ─────────────────────────────────────────────────────────────

model TeamMember {
  id          String   @id @default(cuid())
  slug        String   @unique @db.VarChar(80)
  name        String   @db.VarChar(120)
  /// Configurable — leave empty until the team confirms.
  role        String?  @db.VarChar(120)
  bio         String?  @db.Text
  photoUrl    String?
  skills      String[]
  linkedinUrl String?
  githubUrl   String?
  order       Int      @default(0)
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Service {
  id               String    @id @default(cuid())
  slug             String    @unique @db.VarChar(80)
  title            String    @db.VarChar(120)
  shortDescription String    @db.VarChar(400)
  description      String?   @db.Text
  /// Key of the icon / visual used by the frontend (see src/components/services/service-icon.tsx).
  icon             String    @default("code") @db.VarChar(40)
  technologies     String[]
  order            Int       @default(0)
  published        Boolean   @default(true)
  projects         Project[] @relation("ProjectServices")
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model Project {
  id           String         @id @default(cuid())
  slug         String         @unique @db.VarChar(80)
  title        String         @db.VarChar(160)
  category     String         @db.VarChar(160)
  summary      String         @db.VarChar(600)
  overview     String?        @db.Text
  problem      String?        @db.Text
  solution     String?        @db.Text
  features     String[]
  techStack    String[]
  contribution String?        @db.Text
  /// Only fill in with verified outcomes.
  results      String?        @db.Text
  /// Illustrative visual style used when no screenshots exist (see project-visual.tsx).
  visual       String         @default("generic") @db.VarChar(40)
  accent       String         @default("#6D7CFF") @db.VarChar(16)
  coverImage   String?
  liveUrl      String?
  featured     Boolean        @default(true)
  order        Int            @default(0)
  published    Boolean        @default(true)
  images       ProjectImage[]
  services     Service[]      @relation("ProjectServices")
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([published, order])
}

model ProjectImage {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  url       String
  alt       String   @default("") @db.VarChar(240)
  caption   String?  @db.VarChar(240)
  order     Int      @default(0)
  createdAt DateTime @default(now())

  @@index([projectId, order])
}

model Testimonial {
  id            String   @id @default(cuid())
  clientName    String   @db.VarChar(120)
  designation   String?  @db.VarChar(120)
  company       String?  @db.VarChar(160)
  avatarUrl     String?
  review        String   @db.Text
  projectName   String?  @db.VarChar(160)
  /// The client has approved publishing this testimonial.
  clientApproved Boolean @default(false)
  /// Sample data that must be replaced before launch.
  isPlaceholder Boolean  @default(false)
  order         Int      @default(0)
  published     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Faq {
  id        String   @id @default(cuid())
  question  String   @db.VarChar(300)
  answer    String   @db.Text
  order     Int      @default(0)
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SocialLink {
  id        String   @id @default(cuid())
  platform  String   @unique @db.VarChar(40)
  label     String   @db.VarChar(80)
  url       String
  order     Int      @default(0)
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Singleton row (id = 1) for settings editable from the admin panel.
model SiteSettings {
  id                   Int      @id @default(1)
  availableForProjects Boolean  @default(true)
  availabilityText     String   @default("Available for selected projects") @db.VarChar(120)
  contactEmail         String?  @db.VarChar(254)
  updatedAt            DateTime @updatedAt
}

// ─────────────────────────────────────────────────────────────
// Leads
// ─────────────────────────────────────────────────────────────

enum InquiryStatus {
  NEW
  CONTACTED
  IN_DISCUSSION
  CONVERTED
  REJECTED
}

model ContactInquiry {
  id              String        @id @default(cuid())
  fullName        String        @db.VarChar(120)
  email           String        @db.VarChar(254)
  phone           String?       @db.VarChar(32)
  companyName     String?       @db.VarChar(160)
  projectType     String        @db.VarChar(60)
  estimatedBudget String        @db.VarChar(60)
  projectTimeline String        @db.VarChar(60)
  description     String        @db.Text
  consent         Boolean
  status          InquiryStatus @default(NEW)
  adminNotes      String?       @db.Text
  /// SHA-256 of the client IP + secret — never the raw IP.
  ipHash          String?       @db.VarChar(64)
  userAgent       String?       @db.VarChar(400)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([status, createdAt])
  @@index([createdAt])
  @@index([email])
}
