# ─── Database (PostgreSQL) ───────────────────────────────────
# Local dev: `docker compose up -d` starts Postgres on port 5442.
DATABASE_URL="postgresql://agency:agency_dev_password@localhost:5442/agency?schema=public"

# ─── Admin authentication ────────────────────────────────────
# Long random string (>= 32 chars). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=""
# Used by `npm run db:seed` / `npm run admin:create` to create the first admin.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD=""
ADMIN_NAME="Admin"

# Salt for hashing visitor IPs (rate-limit audit trail). Random string.
IP_HASH_SALT=""

# ─── Public site ─────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Brand name is a placeholder until finalised.
NEXT_PUBLIC_BRAND_NAME="Nexor Automations"
NEXT_PUBLIC_CONTACT_EMAIL="hello@yourdomain.com"
# Set to "false" before launch to hide "To be confirmed" markers and sample testimonials.
NEXT_PUBLIC_SHOW_PLACEHOLDERS="true"

# ─── Uploads ─────────────────────────────────────────────────
# Where admin-uploaded images are stored on disk (served at /uploads/*).
UPLOAD_DIR="storage/uploads"

# ─── Optional: email notification for new inquiries (SMTP) ───
# Leave blank to disable. Inquiries are always saved to the database.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM=""
NOTIFY_EMAIL_TO=""

# ─── Optional: privacy-friendly analytics ────────────────────
# Plausible (cookieless) — your site domain, e.g. "example.com".
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=""
# Google Analytics 4 measurement ID, e.g. "G-XXXXXXX". Loaded only if set.
NEXT_PUBLIC_GA_ID=""
